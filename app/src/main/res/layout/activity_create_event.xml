<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F9"
    android:fillViewport="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A hacer música!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/editTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Título del evento"
                android:background="@drawable/bg_edittext_rounded"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descripción"
                android:background="@drawable/bg_edittext_rounded"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editLatitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Latitud (ej: 41.3851)"
                android:inputType="numberDecimal|numberSigned"
                android:background="@drawable/bg_edittext_rounded"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editLongitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Longitud (ej: 2.1734)"
                android:inputType="numberDecimal|numberSigned"
                android:background="@drawable/bg_edittext_rounded"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editAforo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Aforo máximo del bar"
                android:inputType="number"
                android:background="@drawable/bg_edittext_rounded"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="URL de la imagen (opcional)"
                android:inputType="textUri"
                android:background="@drawable/bg_edittext_rounded"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Género musical"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerGenero"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner_rounded"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnFecha"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Seleccionar fecha"
                android:textColor="#1A237E"
                android:backgroundTint="@android:color/transparent"
                android:background="@drawable/btn_outline_primary"
                app:cornerRadius="30dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnCrear"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Crear concierto"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EE"
                app:cornerRadius="30dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>