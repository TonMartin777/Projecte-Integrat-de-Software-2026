<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="10dp"
    tools:context=".EventDetailActivity">

    <LinearLayout
        android:layout_width="347dp"
        android:layout_height="539dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:layout_marginBottom="16dp"
            app:srcCompat="@drawable/ic_launcher_background" />

        <TextView
            android:id="@+id/detailNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView" />

        <TextView
            android:id="@+id/detailFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView" />

        <TextView
            android:id="@+id/detailUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView" />

        <TextView
            android:id="@+id/detailInformacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este evento trata de bla blablabla  bla blablablabla blablabla bla blablabla bla blablabla bla blablabla bla blablabla bla blablabla bla blablabla" />

        <TextView
            android:id="@+id/detailCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="#Deporte #Cine #Juegos" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>